{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "internal": {
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      }
    }
  }
}